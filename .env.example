# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env asla commit edilmez.

# Web panel girişi
ADMIN_USERNAME=admin
ADMIN_PASSWORD=degistir-beni
# Oturum çerezlerini imzalamak için uzun rastgele bir değer
# (örn: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Binance gerçek hesap anahtarları (sadece mode=live botlar kullanır)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance Spot Testnet anahtarları (https://testnet.binance.vision) — mode=testnet botlar kullanır
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Gerçek parayla işlem açmak için bilinçli olarak true yapılmalı. false iken live botlar başlatılamaz.
ALLOW_LIVE_TRADING=false

# SQLite veritabanı yolu
DATABASE_PATH=tradebot.db

# Sunucu yeniden başladığında "running" durumundaki botları otomatik başlat
RESUME_BOTS_ON_STARTUP=true

# HTTPS arkasında çalışıyorsanız true yapın (çerez sadece HTTPS üzerinden gönderilir)
SESSION_HTTPS_ONLY=false
